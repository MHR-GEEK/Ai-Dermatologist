# Ollama Cloud or local Ollama server
AI_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=replace-with-a-new-ollama-api-key
OLLAMA_MODEL=gemma4:31b
OLLAMA_CHAT_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=90

# Required in production: set unique values in Vercel Environment Variables
ADMIN_PASSWORD=replace-this-admin-password
SECRET_KEY=replace-with-a-long-random-secret
